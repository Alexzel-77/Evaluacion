<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="ni.edu.ni.evaluacion.controller.ProductoController" prefWidth="900" prefHeight="700">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>


    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Buscar:"/>
        <TextField fx:id="txtBuscar" promptText="Nombre o Código"/>
        <ComboBox fx:id="cmbFiltroCategoria"/>
        <CheckBox fx:id="chkExistencias" text="Solo con existencias"/>
        <Button text="Buscar" onAction="#buscar"/>
        <Button text="Limpiar Filtros" onAction="#limpiarFiltros"/>
        <Button text="Recargar" onAction="#cargarDatos"/>
    </HBox>
    <Label fx:id="lblContador" style="-fx-font-weight: bold;"/>


    <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS" onMouseClicked="#seleccionarRegistro">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="100"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="250"/>
            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="150"/>
            <TableColumn fx:id="colPrecio" text="Precio C$" prefWidth="100"/>
            <TableColumn fx:id="colStock" text="Stock" prefWidth="100"/>
        </columns>
    </TableView>

    <Separator/>

    <!-- Formulario -->
    <GridPane hgap="10" vgap="10">
        <Label text="Código:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCodigo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Categoría:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbCategoria" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Precio:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="txtPrecio" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Stock:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="txtStock" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
    </GridPane>


    <HBox spacing="10">
        <Button text="Nuevo/Limpiar" onAction="#limpiarFormulario"/>
        <Button text="Guardar" onAction="#guardar"/>
        <Button text="Eliminar" onAction="#eliminar"/>
    </HBox>
</VBox>